{
  "name": "voicetag",
  "productName": "TACTIQ ANALYST",
  "version": "2.4.0",
  "description": "TACTIQ ANALYST – football video analysis: voice tagging, code window, manual tracking, pitch calibration",
  "main": "main.js",
  "author": "Dumitru Ciprian Lulciuc",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis --x64"
  },
  "dependencies": {
    "ffmpeg-static": "5.3.0",
    "onnxruntime-node": "^1.23.2"
  },
  "devDependencies": {
    "electron": "38.8.6",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "com.voicetag.app",
    "productName": "TACTIQ ANALYST",
    "copyright": "VoiceTag",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "exporter.js",
      "renderer/**/*",
      "!renderer/_*.mp4",
      "build/icon.png",
      "package.json",
      "engine/*.js",
      "!node_modules/onnxruntime-node/bin/napi-v6/linux/**",
      "!node_modules/onnxruntime-node/bin/napi-v6/darwin/**",
      "!node_modules/onnxruntime-node/bin/napi-v6/win32/arm64/**"
    ],
    "extraResources": [
      {
        "from": "model",
        "to": "model",
        "filter": [
          "model.tar.gz"
        ]
      },
      {
        "from": "engine/models",
        "to": "ai-models",
        "filter": [
          "*.onnx"
        ]
      }
    ],
    "asarUnpack": [
      "node_modules/ffmpeg-static/**",
      "node_modules/onnxruntime-node/**",
      "node_modules/onnxruntime-common/**",
      "engine/*.js"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "TACTIQ ANALYST",
      "artifactName": "TACTIQ-ANALYST-Setup-${version}.${ext}",
      "uninstallDisplayName": "TACTIQ ANALYST"
    },
    "fileAssociations": [
      {
        "ext": "tactiq",
        "name": "TACTIQ ANALYST project",
        "description": "TACTIQ ANALYST project"
      }
    ]
  }
}
